# Git LFS for NEW large binaries under builds/ (owner 2026-10-13: LFS for new binaries, no history rewrite).
# docs/ stays out of LFS: GitHub Pages serves docs/ and cannot serve LFS objects.
builds/**/*.blend filter=lfs diff=lfs merge=lfs -text
builds/**/*.blend1 filter=lfs diff=lfs merge=lfs -text
builds/**/*.stl filter=lfs diff=lfs merge=lfs -text
builds/**/*.glb filter=lfs diff=lfs merge=lfs -text
builds/**/*.gltf filter=lfs diff=lfs merge=lfs -text
builds/**/*.3mf filter=lfs diff=lfs merge=lfs -text
builds/**/*.fbx filter=lfs diff=lfs merge=lfs -text
builds/**/*.abc filter=lfs diff=lfs merge=lfs -text
builds/**/*.usd filter=lfs diff=lfs merge=lfs -text
builds/**/*.usdz filter=lfs diff=lfs merge=lfs -text
builds/**/*.exr filter=lfs diff=lfs merge=lfs -text
builds/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
builds/**/*.mov filter=lfs diff=lfs merge=lfs -text
builds/**/*.zip filter=lfs diff=lfs merge=lfs -text

