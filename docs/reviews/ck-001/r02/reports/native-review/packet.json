        ],
        "expectation": "Rounded charcoal key faces carry readable white legends; revision-B visible skirt is shorter than the old full-height wall.",
        "falsifier": "Illegible/floating letters, lost rounded form, visibly inconsistent key families."
      },
      {
        "id": "slotted-knobs",
        "views": [
          "hero",
          "knob-detail"
        ],
        "expectation": "Silver cylindrical controls retain actual recessed indicator channels, visible in the close-up.",
        "falsifier": "A flat painted line replaces the channel, slots disappear in the close-up, or geometry breaks."
      },
      {
        "id": "layered-body-and-rgb",
        "views": [
          "hero",
          "exploded"
        ],
        "expectation": "Dark mounting plate, separate PCB, translucent acrylic RGB perimeter and silver lower body remain distinct.",
        "falsifier": "A layer is absent or fused visually; RGB is absent; gross intersections or cropped assembly."
      },
      {
        "id": "underside",
        "views": [
          "bottom"
        ],
        "expectation": "Silver underside and four separate dark feet are visible, without added certification claims.",
        "falsifier": "Missing feet, hidden underside, gross crop or unreadable lighting."
      },
      {
        "id": "modeled-interfaces",
        "views": [
          "receiver",
          "spacebar-guides",
          "D-receiver"
        ],
        "expectation": "Revision-B declared design additions are visible: real cross receiver, two integral guide pins, stepped D receiver.",
        "falsifier": "A promised opening or guide is missing, hidden or substituted by a flat surface. This is design inspection, not proof of source-photo hidden geometry."
      },
      {
        "id": "supported-hardware",
        "views": [
          "encoder-mount",
          "usb-mount"
        ],
        "expectation": "Encoder carrier/shaft/hardware and mounted USB assembly are inspectable as the declared prototype design.",
        "falsifier": "Required support geometry is absent, occluded beyond useful inspection or visibly disconnected. No electrical or load qualification is inferred."
      }
    ],
    "scope": "Owner-requested reconstruction and declared revision-B mechanical adaptations. Camera poses differ from source sheets; record visible deviations, not a similarity score."
